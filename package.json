{
  "name": "orderloop",
  "version": "0.1.0",
  "private": true,
  "description": "Order-to-cash tracker on top of SAP S/4HANA Cloud OData APIs: incremental sync, O2C status and receivables, Next.js dashboard, Azure Functions scheduler, Power BI views.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate": "node src/core/cli.ts migrate",
    "sync": "node src/core/cli.ts sync",
    "sap:probe": "node src/core/cli.ts probe",
    "mock-sap": "node mock-sap/server.ts"
  },
  "engines": {
    "node": ">=22.18"
  },
  "dependencies": {
    "next": "^16.4.6",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  }
}
